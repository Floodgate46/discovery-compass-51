generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DiscoverySubmission {
  id           String   @id @default(cuid())
  companyName  String?
  industry     String?
  country      String?
  contactEmail String?
  payload      Json
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyName])
  @@index([industry])
  @@index([country])
  @@map("discovery_submissions")
}
